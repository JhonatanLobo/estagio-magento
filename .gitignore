compose.versions.yaml
env/
rootCA.pem
.env
.env.*
!.env.example

# 1. Bloquear todo o conteudo da raiz de src (arquivos nativos do Magento)
/src/*

# 2. Abrir excecao exclusivamente para modulo e tema customizados
!/src/app/
/src/app/*

# Modulo PHP
!/src/app/code/
/src/app/code/*
!/src/app/code/Webjump/

# Tema Frontend
!/src/app/design/
/src/app/design/*
!/src/app/design/frontend/
/src/app/design/frontend/*
!/src/app/design/frontend/Webjump/

# 3. Bloquear caches, logs e ambientes
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
*.temp
*.swp
*.swo
*~

.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
.phpstan.cache/
coverage/

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*